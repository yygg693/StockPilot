# StockPilot Environment Variables
# Copy to .env and fill in your values

# AI Service (DeepSeek / OpenAI-compatible)
STOCKPILOT_AI_KEY=sk-your-api-key-here
STOCKPILOT_AI_BASE_URL=https://api.deepseek.com
STOCKPILOT_AI_MODEL=deepseek-chat

# API Authentication (optional, protects /api/* endpoints)
STOCKPILOT_SERVER_API_KEY=

# Server
STOCKPILOT_SERVER_HOST=127.0.0.1
STOCKPILOT_SERVER_PORT=8000

# Debug mode
STOCKPILOT_DEBUG=false
